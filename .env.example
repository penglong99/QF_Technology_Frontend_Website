# Copy to `.env` (or `.env.local`) and adjust. See POS_INTEGRATION.md.
#
# VITE_* values are compiled into the public JavaScript bundle. Never put passwords,
# API secrets or database credentials in them.

# Where product data comes from: `mock` (local sample data, default) or `pos` (POS API).
VITE_PRODUCT_SOURCE=mock

# Base URL the browser calls for product data. Point it at the website's own server-side
# proxy to the POS API (recommended), or at the POS API itself if it is public and allows CORS.
VITE_POS_API_BASE_URL=/api/pos

# Optional: prefix for product images the POS returns as relative paths.
# VITE_POS_IMAGE_BASE_URL=https://pos.example.com/storage

# Optional: request timeout in milliseconds (default 10000).
# VITE_API_TIMEOUT_MS=10000

# Development only, read by the Vite dev server (not exposed to the browser):
# forwards /api/pos/* to this address. Example: http://localhost:8000/api/v1
# POS_API_PROXY_TARGET=
